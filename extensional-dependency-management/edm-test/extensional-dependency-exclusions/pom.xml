<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>extensional-dependency-exclusions</artifactId>
    <name>IT - extensional dependency exclusions</name>

    <parent>
        <groupId>de.silverhorn.fca.maven</groupId>
        <artifactId>edm-test</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <packaging>pom</packaging>

    <modules>
        <module>dependency-exclusions-enforcing</module>
        <module>dependency-exclusions-packaging</module>
        <module>dependency-exclusions-global</module>
    </modules>

    <build>
        <plugins>
            <!--
                Configure the edm-maven-plugin as a Maven Extension so that
                ExtensionalDependencyManagementExtension (AbstractMavenLifecycleParticipant)
                is activated for the entire reactor.

                With <extensions>true</extensions> Maven loads the plugin JAR as a build
                extension and calls afterProjectsRead() before any dependency resolution
                takes place.

                Two exclusion modes are demonstrated here:

                1. <dependencies>  — targeted exclusions
                   Exclusions are injected only into direct dependencies that match the
                   configured carrier (undertow-core → exclude xnio-nio).

                2. <globalExclusions> — blanket exclusions
                   Exclusions are injected into EVERY direct dependency of EVERY reactor
                   module. Use this when the carrier is itself only transitively present
                   or when you want a blanket ban regardless of the transitive path.
                   (e.g. jboss-logging is provided by the target runtime and must never
                   be bundled, no matter which dependency brings it in.)
            -->
            <plugin>
                <groupId>de.silverhorn.fca.maven</groupId>
                <artifactId>edm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>

                    <!-- Mode 1: targeted — only applied when undertow-core is a direct dep -->
                    <dependencies>
                        <dependency>
                            <groupId>io.undertow</groupId>
                            <artifactId>undertow-core</artifactId>
                            <exclusions>
                                <exclusion>
                                    <groupId>org.jboss.xnio</groupId>
                                    <artifactId>xnio-nio</artifactId>
                                </exclusion>
                            </exclusions>
                        </dependency>
                    </dependencies>

                    <!--
                        Mode 2: global — injected into every direct dependency.
                        jboss-logging is provided by the target runtime (e.g. WildFly/JBoss)
                        and must never be bundled in a delivered artifact, regardless of which
                        transitive dependency carries it.
                    -->
                    <globalExclusions>
                        <exclusion>
                            <groupId>org.jboss.logging</groupId>
                            <artifactId>jboss-logging</artifactId>
                        </exclusion>
                    </globalExclusions>

                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
